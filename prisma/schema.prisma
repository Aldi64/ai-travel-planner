generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions    Session[]
  accounts    Account[]
  trips       Trip[]
  savedPlaces SavedPlace[]

  @@map("user")
}

// --- Auth.js / Prisma adapter models ---

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

// --- Core domain models ---

model Trip {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Search inputs
  origin             String // display label, e.g. "Jakarta"
  originCode         String // IATA code from the airports dataset, e.g. "CGK"
  destinationCity    String?
  destinationCountry String?
  startDate          DateTime
  endDate            DateTime
  groupSize          Int
  tripStyles         String[] // multi-select, e.g. ["relaxing", "cultural"]
  currency           String // ISO 4217, e.g. "USD"; all amounts below use it

  // Budget, split by category (in `currency`)
  flightsBudget    Float
  stayBudget       Float
  foodBudget       Float
  activitiesBudget Float

  // AI planning state
  status        TripStatus @default(PLANNING)
  failureReason String? // "NO_FIT" | "AI_INVALID" | "UPSTREAM" | "UNKNOWN"
  candidates    Json? // [{ destination, reasoning, estimatedFlightPrice, estimatedHotelPrice }]

  selectedFlight Flight?
  selectedHotel  Hotel?
  itineraryDays  ItineraryDay[]

  totalEstimatedCost Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum TripStatus {
  PLANNING
  COMPLETED
  FAILED
}

model Flight {
  id     String @id @default(cuid())
  tripId String @unique
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  carrier    String
  price      Float
  departTime DateTime
  arriveTime DateTime
  bookingRef String? // provider offer id or deep link ref, useful later for v2 booking links
}

model Hotel {
  id     String @id @default(cuid())
  tripId String @unique
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  name          String
  pricePerNight Float
  totalPrice    Float
  rating        Float?
  address       String?
}

model ItineraryDay {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  dayNumber Int
  date      DateTime

  items ItineraryItem[]

  @@index([tripId])
}

model ItineraryItem {
  id             String       @id @default(cuid())
  itineraryDayId String
  itineraryDay   ItineraryDay @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)

  type          ItemType
  name          String
  description   String?
  startTime     String? // "09:00", kept as a string, no timezone math needed for a single-day plan
  estimatedCost Float
  placeId       String? // external ref, e.g. Google Place ID
}

enum ItemType {
  ACTIVITY
  FOOD
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum AreaCategory {
  TOURIST_AREA
  LANDMARK
  NATURE
  FOOD
  TRANSPORTATION
}

// Caches one category's results for one city, so repeat searches don't
// re-spend Geoapify credits or Gemini calls every time.
model AreaSearchCache {
  id        String       @id @default(cuid())
  city      String
  category  AreaCategory
  data      Json // array of place results, or the transportation summary object
  fetchedAt DateTime     @default(now())

  @@unique([city, category])
}

model SavedPlace {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  category    AreaCategory
  source      String // "geoapify" | "ai"
  externalId  String? // Geoapify's place id; null for AI-named food spots (no stable id)
  name        String
  description String?
  address     String?
  photoUrl    String?
  rating      Float?
  city        String // the city this was discovered under

  createdAt DateTime @default(now())

  @@unique([userId, category, name, city]) // prevents saving the same place twice
}
